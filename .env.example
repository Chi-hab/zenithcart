# ----------------------------------------------------------------------------- #
# ZenithCart — root environment (consumed by docker-compose for every service)
# Copy to `.env` and adjust before running `docker compose up`.
# ----------------------------------------------------------------------------- #

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- PostgreSQL (db service) ---
POSTGRES_DB=zenithcart
POSTGRES_USER=zenith
POSTGRES_PASSWORD=zenith
DATABASE_URL=postgres://zenith:zenith@db:5432/zenithcart

# --- Redis / Celery (redis service) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Set False so heavy work is dispatched to the celery_worker container.
CELERY_TASK_ALWAYS_EAGER=False

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Throttling (requests/min) ---
THROTTLE_AUTH=10/min
THROTTLE_CHECKOUT=20/min
THROTTLE_PAYMENT=15/min

# --- CORS (Next.js frontend origin only) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Email (console backend in dev; SMTP in prod) ---
DEFAULT_FROM_EMAIL=noreply@zenithcart.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Frontend ---
# Public URL baked into the client bundle at build time (used by the browser).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Internal URL used for SSR/SSG fetches container-to-container (runtime only).
INTERNAL_API_URL=http://web:8000/api/v1
